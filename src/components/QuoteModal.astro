---
import { modalInsurers } from '../data/insurers';

// SVG renderers for the 2 insurers
function getInsurerModalSvg(id: string) {
  switch (id) {
    case 'federacion-patronal':
      return `
        <svg viewBox="0 0 100 100" class="w-16 h-16 shrink-0 transition-transform duration-300 group-hover:scale-105">
          <circle cx="50" cy="50" r="46" fill="#034EA2" />
          <path d="M50 20 L76 34 V52 C76 66 65 78 50 82 C35 78 24 66 24 52 V34 Z" fill="#FFFFFF"/>
          <path d="M50 28 L68 38 V50 C68 60 60 70 50 73 C40 70 32 60 32 50 V38 Z" fill="#034EA2"/>
          <text x="50" y="55" font-family="sans-serif" font-size="14" font-weight="900" fill="#FFFFFF" text-anchor="middle">FP</text>
        </svg>
      `;
    case 'san-cristobal':
      return `
        <svg viewBox="0 0 100 100" class="w-16 h-16 shrink-0 transition-transform duration-300 group-hover:scale-105">
          <rect width="92" height="92" x="4" y="4" rx="20" fill="#E2001A" />
          <path d="M50 22 L72 35 V52 C72 65 62 76 50 80 C38 76 28 65 28 52 V35 Z" fill="#FFFFFF"/>
          <path d="M42 42 L48 48 L60 36" stroke="#E2001A" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        </svg>
      `;
    default:
      return '';
  }
}
---

<div
  id="quote-modal"
  class="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-6 opacity-0 pointer-events-none transition-all duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <!-- Modal Backdrop -->
  <div id="modal-backdrop" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md transition-opacity"></div>

  <!-- Modal Dialog (Bottom Sheet on mobile, centered card on desktop) -->
  <div 
    class="relative w-full max-w-xl bg-slate-900 border-t sm:border border-slate-700/80 rounded-t-3xl sm:rounded-3xl shadow-2xl overflow-hidden flex flex-col z-10 transform translate-y-full sm:translate-y-0 sm:scale-95 transition-all duration-300 max-h-[90vh]"
    id="modal-card"
  >
    <!-- Drag pill indicator for mobile -->
    <div class="pt-3 pb-0 flex justify-center sm:hidden">
      <div class="w-12 h-1.5 bg-slate-700 rounded-full"></div>
    </div>

    <!-- Header -->
    <div class="p-5 sm:p-8 border-b border-slate-800 flex items-start justify-between bg-slate-950/60">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-900/40 border border-blue-500/30 text-blue-300 text-xs font-semibold mb-2">
          <span>Cotización Online Directa</span>
        </div>
        <h3 id="modal-title" class="text-xl sm:text-2xl font-bold text-white tracking-tight">
          Elegí tu Compañía Aseguradora
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 mt-1 leading-relaxed">
          Hacé clic en la aseguradora con la que deseás cotizar para acceder a su plataforma oficial:
        </p>
      </div>

      <!-- Close Button -->
      <button
        id="close-modal-btn"
        type="button"
        class="text-slate-400 hover:text-white p-2.5 rounded-xl hover:bg-slate-800 transition-colors cursor-pointer shrink-0 ml-3 min-w-[40px] min-h-[40px] flex items-center justify-center"
        aria-label="Cerrar modal"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Body: 2 Clickable Insurer Cards -->
    <div class="p-5 sm:p-8 overflow-y-auto pb-[calc(1.5rem+env(safe-area-inset-bottom,0px))] sm:pb-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 sm:gap-6">
        {modalInsurers.map((insurer) => (
          <a
            href={insurer.quoteUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative flex flex-col items-center text-center p-4 sm:p-6 rounded-2xl border-2 border-slate-800 bg-slate-950/70 hover:border-blue-500 hover:bg-slate-800/60 hover:shadow-xl hover:shadow-blue-600/10 transition-all duration-300 transform active:scale-98"
          >
            <!-- Insurer Logo -->
            <div class="w-24 h-16 sm:w-28 sm:h-20 bg-white rounded-xl sm:rounded-2xl p-2 flex items-center justify-center border border-slate-700/80 shadow-md shrink-0 mb-3 sm:mb-4 overflow-hidden group-hover:scale-105 transition-transform duration-300">
              {insurer.logoImg ? (
                <img 
                  src={insurer.logoImg} 
                  alt={insurer.name} 
                  class="max-h-full max-w-full object-contain"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center" set:html={getInsurerModalSvg(insurer.id)} />
              )}
            </div>

            <!-- Insurer Name -->
            <h4 class="text-base sm:text-lg font-bold text-white group-hover:text-blue-300 transition-colors mb-1">
              {insurer.name}
            </h4>

            <!-- Short Tagline -->
            <p class="text-xs text-slate-400 mb-4 sm:mb-6 line-clamp-2">
              {insurer.tagline}
            </p>

            <!-- Direct Action Prompt -->
            <div class="mt-auto w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-blue-600 group-hover:bg-blue-500 text-white font-semibold text-xs tracking-wide transition-all shadow-md">
              <span>Ingresar a cotizar</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="9 18 15 12 9 6"/>
              </svg>
            </div>
          </a>
        ))}
      </div>

      <p class="text-center text-[11px] text-slate-400 mt-4 sm:mt-6">
        🔒 Acceso directo y seguro al cotizador oficial de cada compañía.
      </p>
    </div>
  </div>
</div>

<script>
  function setupModal() {
    const modal = document.getElementById('quote-modal');
    const modalCard = document.getElementById('modal-card');
    const backdrop = document.getElementById('modal-backdrop');
    const closeBtn = document.getElementById('close-modal-btn');

    function openModal() {
      if (!modal || !modalCard) return;
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100', 'pointer-events-auto');
      modalCard.classList.remove('translate-y-full', 'sm:scale-95');
      modalCard.classList.add('translate-y-0', 'sm:scale-100');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal || !modalCard) return;
      modal.classList.remove('opacity-100', 'pointer-events-auto');
      modal.classList.add('opacity-0', 'pointer-events-none');
      modalCard.classList.remove('translate-y-0', 'sm:scale-100');
      modalCard.classList.add('translate-y-full', 'sm:scale-95');
      document.body.style.overflow = '';
    }

    modal?.addEventListener('open-modal', openModal);
    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal?.classList.contains('opacity-100')) {
        closeModal();
      }
    });
  }

  setupModal();
  document.addEventListener('astro:page-load', setupModal);
</script>
