---
import { coverages } from '../data/coverages';
import { companyInfo } from '../data/companyInfo';
---

<section id="contacto" class="py-24 bg-slate-50 border-b border-slate-200 scroll-mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-bold uppercase tracking-wider mb-3">
        <span>Atención Personalizada</span>
        <span>•</span>
        <span>Respuesta Inmediata</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
        Solicitá tu Cotización sin Compromiso
      </h2>
      <p class="text-base sm:text-lg text-slate-600">
        Completá tus datos y un productor asesor se comunicará con vos para brindarte un presupuesto comparativo a medida.
      </p>
    </div>

    <div class="max-w-4xl mx-auto">
      <!-- Main Contact Card -->
      <div class="bg-white rounded-3xl p-8 sm:p-12 shadow-xl border border-slate-200 relative overflow-hidden">
        
        <!-- Success Alert Container (Hidden initially) -->
        <div id="contact-success-alert" class="hidden mb-8 p-6 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900 transition-all">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </div>
            <div class="flex-1">
              <h4 class="text-lg font-bold text-emerald-950">¡Solicitud recibida con éxito!</h4>
              <p class="text-sm text-emerald-800 mt-1">
                Muchas gracias por contactarte. Hemos registrado tus datos y un asesor matriculado de FLS Seguros se pondrá en contacto a la brevedad.
              </p>
              <div class="mt-4 pt-3 border-t border-emerald-200 flex flex-wrap items-center gap-4">
                <a 
                  id="whatsapp-direct-send"
                  href={`https://wa.me/${companyInfo.whatsappNumber}`} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition-colors"
                >
                  <span>Abrir chat de WhatsApp con estos datos</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="9 18 15 12 9 6"/>
                  </svg>
                </a>
                <button
                  type="button"
                  id="reset-form-btn"
                  class="text-xs text-emerald-800 underline hover:text-emerald-950 font-medium cursor-pointer"
                >
                  Enviar otra consulta
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- The Form -->
        <form id="contact-form" class="space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            
            <!-- Campo: Nombre -->
            <div>
              <label for="contact-name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                Nombre y Apellido <span class="text-red-500">*</span>
              </label>
              <div class="relative">
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  placeholder="Ej: Marcelo Fernández"
                  class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3.5 text-sm text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all"
                />
              </div>
            </div>

            <!-- Campo: Correo -->
            <div>
              <label for="contact-email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                Correo Electrónico <span class="text-red-500">*</span>
              </label>
              <div class="relative">
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  required
                  placeholder="tu@email.com"
                  class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3.5 text-sm text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all"
                />
              </div>
            </div>

            <!-- Campo: Teléfono -->
            <div>
              <label for="contact-phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                Teléfono / WhatsApp <span class="text-red-500">*</span>
              </label>
              <div class="relative">
                <input
                  type="tel"
                  id="contact-phone"
                  name="phone"
                  required
                  placeholder="Ej: +54 9 11 1234-5678"
                  class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3.5 text-sm text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all"
                />
              </div>
            </div>

            <!-- Campo: Dropbox / Select con las 16 coberturas -->
            <div>
              <label for="contact-coverage" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                Cobertura de Interés <span class="text-red-500">*</span>
              </label>
              <div class="relative">
                <select
                  id="contact-coverage"
                  name="coverage"
                  required
                  class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3.5 text-sm text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all appearance-none cursor-pointer"
                >
                  <option value="" disabled selected>Seleccioná una cobertura...</option>
                  {coverages.map((cov) => (
                    <option value={cov.title}>{cov.title} ({cov.category})</option>
                  ))}
                </select>
                <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-slate-500">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="m6 9 6 6 6-6"/>
                  </svg>
                </div>
              </div>
            </div>

          </div>

          <!-- Campo: Mensaje / Detalles -->
          <div>
            <label for="contact-message" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
              Mensaje o Detalles del Seguro (Opcional)
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="3"
              placeholder="Indicanos detalles como año y modelo de auto, ubicación de vivienda, cantidad de empleados para ART, etc."
              class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3.5 text-sm text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all resize-none"
            ></textarea>
          </div>

          <!-- Submit Buttons -->
          <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-slate-100">
            <p class="text-xs text-slate-500">
              🔒 Tus datos personales están protegidos y solo se utilizarán para la cotización.
            </p>

            <button
              type="submit"
              id="submit-contact-btn"
              class="w-full sm:w-auto px-8 py-4 rounded-xl bg-blue-600 hover:bg-blue-500 active:bg-blue-700 text-white font-bold text-sm sm:text-base shadow-xl shadow-blue-600/20 hover:shadow-blue-600/40 transition-all cursor-pointer flex items-center justify-center gap-2"
            >
              <span>Enviar consulta</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
            </button>
          </div>
        </form>

      </div>
    </div>

  </div>
</section>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const successAlert = document.getElementById('contact-success-alert');
    const resetBtn = document.getElementById('reset-form-btn');
    const waDirect = document.getElementById('whatsapp-direct-send') as HTMLAnchorElement | null;
    const phoneInput = document.getElementById('contact-phone') as HTMLInputElement | null;
    const nameInput = document.getElementById('contact-name') as HTMLInputElement | null;
    const coverageInput = document.getElementById('contact-coverage') as HTMLSelectElement | null;
    const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement | null;

    form?.addEventListener('submit', (e) => {
      e.preventDefault();

      const name = nameInput?.value.trim() || 'Cliente';
      const coverage = coverageInput?.value || 'Seguro';
      const phone = phoneInput?.value.trim() || '';
      const notes = messageInput?.value.trim() || '';

      // Prepare custom WhatsApp message for direct link
      if (waDirect) {
        let msg = `Hola FLS Seguros! Mi nombre es ${name}. Quisiera cotizar *${coverage}*.`;
        if (phone) msg += ` Mi teléfono de contacto es: ${phone}.`;
        if (notes) msg += ` Detalle adicional: ${notes}`;
        waDirect.href = `https://wa.me/5491155554321?text=${encodeURIComponent(msg)}`;
      }

      // Show mock success state
      form.classList.add('hidden');
      if (successAlert) {
        successAlert.classList.remove('hidden');
        successAlert.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });

    resetBtn?.addEventListener('click', () => {
      form?.reset();
      form?.classList.remove('hidden');
      if (successAlert) {
        successAlert.classList.add('hidden');
      }
    });
  }

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>
