---
import { companyInfo } from '../data/companyInfo';
---

<footer class="bg-slate-950 text-slate-400 pt-16 pb-12 border-t border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-slate-800">
      
      <!-- Brand & Description (2 cols on md) -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-blue-600/20 border border-blue-500/30 flex items-center justify-center text-blue-400">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
          </div>
          <div>
            <span class="text-xl font-black text-white tracking-tight">FLS</span>
            <span class="text-xl font-light text-blue-400 tracking-wider">SEGUROS</span>
          </div>
        </div>

        <p class="text-xs sm:text-sm text-slate-400 max-w-md leading-relaxed">
          Organización y Productor Asesor de Seguros independiente. Brindamos asesoramiento personalizado y respaldo integral con las compañías aseguradoras más prestigiosas y solventes de Argentina.
        </p>

        <div class="pt-2">
          <span class="text-xs font-mono text-slate-300 bg-slate-900 border border-slate-800 px-3 py-1.5 rounded-lg inline-block">
            {companyInfo.matricula}
          </span>
        </div>
      </div>

      <!-- Quick Nav -->
      <div class="space-y-3">
        <h4 class="text-sm font-bold text-white tracking-wider uppercase">Navegación</h4>
        <ul class="space-y-2 text-xs sm:text-sm">
          <li><a href="#inicio" class="hover:text-blue-400 transition-colors">Inicio</a></li>
          <li><a href="#coberturas" class="hover:text-blue-400 transition-colors">Coberturas (16 Ramas)</a></li>
          <li><a href="#aseguradoras" class="hover:text-blue-400 transition-colors">Aseguradoras Aliadas</a></li>
          <li><a href="#contacto" class="hover:text-blue-400 transition-colors">Solicitar Cotización</a></li>
        </ul>
      </div>

      <!-- Contact direct -->
      <div class="space-y-3">
        <h4 class="text-sm font-bold text-white tracking-wider uppercase">Contacto Directo</h4>
        <ul class="space-y-2 text-xs sm:text-sm text-slate-400">
          <li class="flex items-center gap-2">
            <span class="text-blue-400">Tel:</span>
            <span>{companyInfo.phoneDisplay}</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-blue-400">Email:</span>
            <span>{companyInfo.email}</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-blue-400">Oficina:</span>
            <span>{companyInfo.address.street}, {companyInfo.address.city}</span>
          </li>
        </ul>
      </div>

    </div>

    <!-- Legal & Copyright -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-[11px] text-slate-500">
      <p>© {new Date().getFullYear()} {companyInfo.name}. Todos los derechos reservados.</p>
      <p class="text-center md:text-right max-w-xl">
        La actividad del Productor Asesor de Seguros se encuentra regulada por la Ley 22.400 y supervisada por la Superintendencia de Seguros de la Nación (SSN).
      </p>
    </div>
  </div>
</footer>
