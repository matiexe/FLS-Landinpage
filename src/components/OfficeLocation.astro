---
import { companyInfo } from '../data/companyInfo';
---

<section class="py-16 bg-slate-100 border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-3xl p-8 sm:p-12 shadow-lg border border-slate-200/90">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <!-- Info column (7 cols) -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-800 text-xs font-bold uppercase tracking-wider">
            <span>Presencia Física & Respaldo</span>
          </div>

          <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            Nuestras Oficinas de Atención
          </h3>

          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            Podés visitarnos personalmente para tramitar pólizas, presentar documentación de siniestros o recibir asesoría presencial de nuestro equipo de productores.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-2">
            <!-- Dirección -->
            <div class="flex items-start gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0 mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </div>
              <div>
                <h4 class="text-sm font-bold text-slate-900">Dirección</h4>
                <p class="text-xs sm:text-sm text-slate-600 mt-0.5 leading-snug">
                  {companyInfo.address.street}
                </p>
                <p class="text-xs text-slate-500">
                  {companyInfo.address.city}, {companyInfo.address.zipCode}
                </p>
              </div>
            </div>

            <!-- Horarios -->
            <div class="flex items-start gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0 mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
              </div>
              <div>
                <h4 class="text-sm font-bold text-slate-900">Horarios de Atención</h4>
                <p class="text-xs sm:text-sm text-slate-600 mt-0.5">
                  {companyInfo.officeHours.weekdays}
                </p>
                <p class="text-xs text-slate-500">
                  {companyInfo.officeHours.saturday}
                </p>
              </div>
            </div>

            <!-- Teléfonos -->
            <div class="flex items-start gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0 mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              </div>
              <div>
                <h4 class="text-sm font-bold text-slate-900">Teléfono & Urgencias</h4>
                <p class="text-xs sm:text-sm text-slate-600 mt-0.5 font-medium">
                  {companyInfo.phoneDisplay}
                </p>
                <p class="text-xs text-emerald-600 font-semibold">
                  Guardia de siniestros 24 hs
                </p>
              </div>
            </div>

            <!-- Correo Electrónico -->
            <div class="flex items-start gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0 mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect width="20" height="16" x="2" y="4" rx="2"/>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                </svg>
              </div>
              <div>
                <h4 class="text-sm font-bold text-slate-900">Correo Electrónico</h4>
                <p class="text-xs sm:text-sm text-slate-600 mt-0.5 font-medium">
                  {companyInfo.email}
                </p>
                <p class="text-xs text-blue-600 font-medium">
                  Consultas y cotizaciones
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Interactive Map Column (5 cols) -->
        <div class="lg:col-span-5 flex flex-col gap-3">
          <div class="relative rounded-2xl overflow-hidden border border-slate-300 shadow-md aspect-[4/3] bg-slate-100">
            <iframe
              title={`Mapa de ubicación de ${companyInfo.name} en ${companyInfo.address.street}, ${companyInfo.address.city}`}
              src={`https://maps.google.com/maps?q=${encodeURIComponent(companyInfo.address.street + ', ' + companyInfo.address.city + ', ' + companyInfo.address.province + ', Argentina')}&t=&z=16&ie=UTF8&iwloc=&output=embed`}
              class="w-full h-full border-0"
              loading="lazy"
              allowfullscreen
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>

          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 px-1">
            <div class="text-xs text-slate-600 font-medium">
              📍 <span>{companyInfo.address.street}, {companyInfo.address.city}</span>
            </div>
            <a
              href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(companyInfo.address.street + ', ' + companyInfo.address.city + ', ' + companyInfo.address.province)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold transition-all shadow-sm shrink-0 cursor-pointer"
            >
              <span>Abrir en Google Maps</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
            </a>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
