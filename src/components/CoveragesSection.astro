---
import { coverages } from '../data/coverages';

// Helper for SVG icons based on iconName
function getIconSvg(name: string) {
  switch (name) {
    case 'Car':
      return `<path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/>`;
    case 'Bike':
      return `<circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/>`;
    case 'Home':
      return `<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>`;
    case 'HeartPulse':
      return `<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M3.22 12H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27"/>`;
    case 'ShieldAlert':
      return `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/>`;
    case 'HardHat':
      return `<path d="M2 18a1 1 0 0 0 1 1h18a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v2z"/><path d="M10 10V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5"/><path d="M4 15v-3a8 8 0 0 1 16 0v3"/>`;
    case 'Store':
      return `<path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"/><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"/><path d="M2 7h20"/><path d="M22 7a2 2 0 0 1-2 2 2 2 0 0 1-2-2 2 2 0 0 1-2 2 2 2 0 0 1-2-2 2 2 0 0 1-2 2 2 2 0 0 1-2-2 2 2 0 0 1-2 2 2 2 0 0 1-2-2"/>`;
    case 'Scale':
      return `<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>`;
    case 'BriefcaseMedical':
      return `<path d="M12 11v4"/><path d="M14 13h-4"/><rect width="20" height="14" x="2" y="6" rx="2"/><path d="M16 6V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>`;
    case 'Building2':
      return `<path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/>`;
    case 'Truck':
      return `<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>`;
    case 'Anchor':
      return `<circle cx="12" cy="5" r="3"/><line x1="12" x2="12" y1="22" y2="8"/><path d="M5 12H2a10 10 0 0 0 20 0h-3"/>`;
    case 'Footprints':
      return `<path d="M4 16v-2.38C4 11.5 2.97 9.5 3 7a5 5 0 0 1 9.87-.93c.12.87.13 1.93-.87 3.93C11 12 9 14 9 16v1a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/><path d="M20 20v-2.38c0-2.12 1.03-4.12 1-6.62a5 5 0 0 0-9.87-.93c-.12.87-.13 1.93.87 3.93 1 2 3 4 3 6v1a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2z"/>`;
    case 'Smartphone':
      return `<rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/>`;
    case 'FileCheck':
      return `<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="m9 15 2 2 4-4"/>`;
    case 'Wheat':
      return `<path d="M2 22 16 8"/><path d="M3.47 12.53 5 11l1.53 1.53a3.5 3.5 0 0 1 0 4.94L5 19l-1.53-1.53a3.5 3.5 0 0 1 0-4.94Z"/><path d="M7.47 8.53 9 7l1.53 1.53a3.5 3.5 0 0 1 0 4.94L9 15l-1.53-1.53a3.5 3.5 0 0 1 0-4.94Z"/><path d="M11.47 4.53 13 3l1.53 1.53a3.5 3.5 0 0 1 0 4.94L13 11l-1.53-1.53a3.5 3.5 0 0 1 0-4.94Z"/><path d="M20 2h2v2a4 4 0 0 1-4 4h-2V6a4 4 0 0 1 4-4Z"/><path d="M11.47 17.47 13 19l-1.53 1.53a3.5 3.5 0 0 1-4.94 0L5 19l1.53-1.53a3.5 3.5 0 0 1 4.94 0Z"/><path d="M15.47 13.47 17 15l-1.53 1.53a3.5 3.5 0 0 1-4.94 0L9 15l1.53-1.53a3.5 3.5 0 0 1 4.94 0Z"/>`;
    default:
      return `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>`;
  }
}
---

<section id="coberturas" class="py-24 bg-slate-100/80 border-b border-slate-200 scroll-mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-bold uppercase tracking-wider mb-3">
        <span>Catálogo Integral</span>
        <span>•</span>
        <span>16 Ramas de Cobertura</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
        Soluciones a Medida para Cada Necesidad
      </h2>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
        Trabajamos de forma independiente para ofrecerte la póliza justa, analizando deducibles, alcance y costos con las compañías líderes del país.
      </p>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center justify-center gap-2 mt-8" id="coverage-filters">
        <button 
          type="button" 
          data-filter="all"
          class="filter-pill active px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all cursor-pointer bg-slate-900 text-white shadow-sm"
        >
          Todas (16)
        </button>
        <button 
          type="button" 
          data-filter="Patrimoniales"
          class="filter-pill px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all cursor-pointer bg-white text-slate-700 hover:bg-slate-200 border border-slate-200"
        >
          Patrimoniales
        </button>
        <button 
          type="button" 
          data-filter="Personas"
          class="filter-pill px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all cursor-pointer bg-white text-slate-700 hover:bg-slate-200 border border-slate-200"
        >
          Personas & Vida
        </button>
        <button 
          type="button" 
          data-filter="Empresas"
          class="filter-pill px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all cursor-pointer bg-white text-slate-700 hover:bg-slate-200 border border-slate-200"
        >
          Empresas & ART
        </button>
        <button 
          type="button" 
          data-filter="Especiales"
          class="filter-pill px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all cursor-pointer bg-white text-slate-700 hover:bg-slate-200 border border-slate-200"
        >
          Especiales & Caución
        </button>
      </div>
    </div>

    <!-- 16 Coverages Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" id="coverages-grid">
      {coverages.map((item) => (
        <div 
          data-category={item.category}
          data-title={item.title}
          class="coverage-card group bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:border-blue-600 hover:shadow-xl hover:shadow-blue-900/5 hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between"
        >
          <div>
            <!-- Card Header: Icon & Category Tag -->
            <div class="flex items-center justify-between mb-5">
              <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 group-hover:bg-blue-600 group-hover:text-white transition-all duration-300 flex items-center justify-center p-2.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-full h-full" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={getIconSvg(item.iconName)} />
              </div>
              
              <div class="flex items-center gap-1.5">
                {item.popular && (
                  <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-blue-600 text-white">
                    Destacado
                  </span>
                )}
                <span class="text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 border border-slate-200">
                  {item.category}
                </span>
              </div>
            </div>

            <!-- Title -->
            <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-700 transition-colors mb-2.5">
              {item.title}
            </h3>

            <!-- Description -->
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              {item.shortDesc}
            </p>
          </div>

          <!-- Card Action Button -->
          <div class="pt-5 mt-5 border-t border-slate-100 flex items-center justify-between">
            <button
              type="button"
              data-coverage={item.title}
              class="quick-quote-coverage inline-flex items-center gap-1.5 text-xs font-bold text-blue-600 group-hover:text-blue-700 hover:underline cursor-pointer"
            >
              <span>Consultar cobertura</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="9 18 15 12 9 6"/>
              </svg>
            </button>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  function setupCoverages() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    const cards = document.querySelectorAll<HTMLElement>('.coverage-card');
    const quoteButtons = document.querySelectorAll<HTMLButtonElement>('.quick-quote-coverage');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter;

        filterButtons.forEach((b) => {
          b.classList.remove('bg-slate-900', 'text-white', 'active');
          b.classList.add('bg-white', 'text-slate-700');
        });

        btn.classList.add('bg-slate-900', 'text-white', 'active');
        btn.classList.remove('bg-white', 'text-slate-700');

        cards.forEach((card) => {
          const cat = card.dataset.category;
          if (filter === 'all' || cat === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // When clicking "Consultar cobertura" on any card:
    quoteButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const coverageName = btn.dataset.coverage;
        const contactSelect = document.getElementById('contact-coverage') as HTMLSelectElement | null;
        const contactSection = document.getElementById('contacto');

        if (contactSelect && coverageName) {
          for (let i = 0; i < contactSelect.options.length; i++) {
            if (contactSelect.options[i].text.includes(coverageName)) {
              contactSelect.selectedIndex = i;
              break;
            }
          }
        }

        if (contactSection) {
          contactSection.scrollIntoView({ behavior: 'smooth' });
          contactSection.classList.add('ring-2', 'ring-blue-500');
          setTimeout(() => {
            contactSection.classList.remove('ring-2', 'ring-blue-500');
          }, 1800);
        }
      });
    });
  }

  setupCoverages();
  document.addEventListener('astro:page-load', setupCoverages);
</script>
