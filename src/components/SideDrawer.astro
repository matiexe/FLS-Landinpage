---
import { companyInfo } from '../data/companyInfo';
---

<!-- Backdrop overlay -->
<div 
  id="drawer-backdrop" 
  class="fixed inset-0 bg-slate-950/70 backdrop-blur-sm z-50 transition-opacity duration-300 opacity-0 pointer-events-none"
  aria-hidden="true"
></div>

<!-- Side Sandwich Drawer -->
<aside
  id="side-drawer"
  class="fixed top-0 right-0 h-full w-full max-w-sm bg-slate-900 text-slate-100 z-50 shadow-2xl flex flex-col justify-between transform translate-x-full transition-transform duration-300 ease-in-out border-l border-slate-800"
  aria-label="Menú de navegación lateral"
  aria-hidden="true"
>
  <!-- Drawer Header -->
  <div class="p-6 border-b border-slate-800 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-blue-600/20 border border-blue-500/30 flex items-center justify-center text-blue-400">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
      </div>
      <div>
        <span class="text-lg font-bold text-white tracking-wide">FLS Seguros</span>
        <p class="text-xs text-slate-400">Asesor de Seguros</p>
      </div>
    </div>
    
    <!-- Close button -->
    <button
      id="close-drawer-btn"
      type="button"
      class="p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors"
      aria-label="Cerrar menú"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Drawer Nav Links -->
  <nav class="p-6 flex-1 overflow-y-auto">
    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-4">Navegación</p>
    <ul class="space-y-2">
      <li>
        <a 
          href="#inicio" 
          class="drawer-link flex items-center gap-4 px-4 py-3 rounded-xl text-slate-200 hover:text-white hover:bg-slate-800/80 transition-colors font-medium text-base group"
        >
          <span class="w-8 h-8 rounded-lg bg-slate-800 flex items-center justify-center text-blue-400 group-hover:bg-blue-600 group-hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </span>
          Inicio
        </a>
      </li>
      <li>
        <a 
          href="#coberturas" 
          class="drawer-link flex items-center gap-4 px-4 py-3 rounded-xl text-slate-200 hover:text-white hover:bg-slate-800/80 transition-colors font-medium text-base group"
        >
          <span class="w-8 h-8 rounded-lg bg-slate-800 flex items-center justify-center text-blue-400 group-hover:bg-blue-600 group-hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
            </svg>
          </span>
          Coberturas
          <span class="ml-auto text-xs px-2 py-0.5 rounded-full bg-blue-900/60 text-blue-300 font-semibold border border-blue-700/40">16 ramas</span>
        </a>
      </li>
      <li>
        <a 
          href="#aseguradoras" 
          class="drawer-link flex items-center gap-4 px-4 py-3 rounded-xl text-slate-200 hover:text-white hover:bg-slate-800/80 transition-colors font-medium text-base group"
        >
          <span class="w-8 h-8 rounded-lg bg-slate-800 flex items-center justify-center text-blue-400 group-hover:bg-blue-600 group-hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="16" height="20" x="4" y="2" rx="2" ry="2"/>
              <path d="M9 22v-4h6v4"/>
              <path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M12 6h.01"/>
              <path d="M12 10h.01"/><path d="M12 14h.01"/><path d="M16 10h.01"/>
              <path d="M16 14h.01"/><path d="M8 10h.01"/><path d="M8 14h.01"/>
            </svg>
          </span>
          Aseguradoras
        </a>
      </li>
      <li>
        <a 
          href="#contacto" 
          class="drawer-link flex items-center gap-4 px-4 py-3 rounded-xl text-slate-200 hover:text-white hover:bg-slate-800/80 transition-colors font-medium text-base group"
        >
          <span class="w-8 h-8 rounded-lg bg-slate-800 flex items-center justify-center text-blue-400 group-hover:bg-blue-600 group-hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </span>
          Contacto
        </a>
      </li>
    </ul>

    <!-- Quick action inside drawer -->
    <div class="mt-8 p-4 rounded-2xl bg-gradient-to-br from-blue-900/40 to-slate-800/60 border border-blue-500/20">
      <h4 class="text-sm font-semibold text-white mb-1">¿Buscás cotización rápida?</h4>
      <p class="text-xs text-slate-300 mb-3">Compará 2 aseguradoras en menos de 5 minutos de forma gratuita.</p>
      <button 
        type="button" 
        id="drawer-quote-trigger"
        class="w-full py-2.5 px-4 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-sm font-semibold shadow-md transition-all text-center block cursor-pointer"
      >
        Cotizar Ahora
      </button>
    </div>
  </nav>

  <!-- Drawer Footer Info -->
  <div class="p-6 border-t border-slate-800 bg-slate-950/40">
    <div class="text-xs text-slate-400 space-y-1 mb-4">
      <p class="font-medium text-slate-300">Oficina Central:</p>
      <p>{companyInfo.address.street}</p>
      <p>{companyInfo.address.city}</p>
      <p class="text-blue-400 font-semibold mt-1">Tel: {companyInfo.phoneDisplay}</p>
    </div>
    
    <a 
      href={`https://wa.me/${companyInfo.whatsappNumber}?text=${encodeURIComponent(companyInfo.whatsappMessage)}`} 
      target="_blank" 
      rel="noopener noreferrer"
      class="w-full py-2.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold flex items-center justify-center gap-2 transition-colors shadow-sm"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.301-.15-1.78-.879-2.056-.979-.276-.101-.477-.15-.678.15-.2.301-.778.979-.954 1.18-.176.2-.352.226-.653.076-.301-.15-1.272-.469-2.423-1.496-.896-.799-1.501-1.787-1.677-2.088-.176-.301-.019-.464.132-.614.136-.135.301-.351.452-.527.15-.176.2-.301.301-.502.101-.201.05-.377-.025-.527-.076-.151-.678-1.633-.929-2.235-.245-.586-.494-.506-.678-.515-.176-.008-.377-.01-.578-.01-.201 0-.527.076-.803.376-.276.302-1.054 1.03-1.054 2.513 0 1.482 1.08 2.912 1.23 3.113.15.201 2.125 3.245 5.148 4.551.719.311 1.28.497 1.718.636.723.23 1.381.198 1.901.12.579-.087 1.78-.728 2.031-1.431.251-.703.251-1.306.176-1.432-.075-.126-.276-.201-.577-.352z"/>
        <path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.981-1.396A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.2c-1.628 0-3.15-.494-4.423-1.341l-.317-.212-3.284.92.936-3.203-.232-.336A8.17 8.17 0 0 1 3.8 12c0-4.521 3.679-8.2 8.2-8.2 4.521 0 8.2 3.679 8.2 8.2 0 4.521-3.679 8.2-8.2 8.2z"/>
      </svg>
      Consultar por WhatsApp
    </a>
  </div>
</aside>

<script>
  function setupDrawer() {
    const openBtn = document.getElementById('open-drawer-btn');
    const closeBtn = document.getElementById('close-drawer-btn');
    const backdrop = document.getElementById('drawer-backdrop');
    const drawer = document.getElementById('side-drawer');
    const links = document.querySelectorAll('.drawer-link');
    const drawerQuoteTrigger = document.getElementById('drawer-quote-trigger');
    const quoteModal = document.getElementById('quote-modal');

    function openDrawer() {
      if (!drawer || !backdrop) return;
      drawer.classList.remove('translate-x-full');
      drawer.classList.add('translate-x-0');
      backdrop.classList.remove('opacity-0', 'pointer-events-none');
      backdrop.classList.add('opacity-100', 'pointer-events-auto');
      drawer.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      if (!drawer || !backdrop) return;
      drawer.classList.remove('translate-x-0');
      drawer.classList.add('translate-x-full');
      backdrop.classList.remove('opacity-100', 'pointer-events-auto');
      backdrop.classList.add('opacity-0', 'pointer-events-none');
      drawer.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    openBtn?.addEventListener('click', openDrawer);
    closeBtn?.addEventListener('click', closeDrawer);
    backdrop?.addEventListener('click', closeDrawer);

    links.forEach((link) => {
      link.addEventListener('click', () => {
        closeDrawer();
      });
    });

    drawerQuoteTrigger?.addEventListener('click', () => {
      closeDrawer();
      if (quoteModal) {
        quoteModal.dispatchEvent(new CustomEvent('open-modal'));
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer?.getAttribute('aria-hidden') === 'false') {
        closeDrawer();
      }
    });
  }

  // Setup on page load and page transitions
  setupDrawer();
  document.addEventListener('astro:page-load', setupDrawer);
</script>
